{"_id":"68a7361a8ec3d8323af171e3","nodeId":"ZhSuu2VArnzPDp6dPQQSC","roadmapSlug":"frontend","createdAt":"2025-08-21T15:07:06.147Z","description":"# Domain Name\n\nDomain names are human-friendly web addresses (e.g., [google.com](http://google.com)) substituting numerical IP addresses. Comprise second-level (\"google\") and top-level (\".com\") domains. Registered through registrars, essential for branding and online presence. DNS translates names to IP addresses for accessibility.","resources":[{"type":"article","title":"What is a Domain Name?","url":"https://developer.mozilla.org/en-US/docs/Learn/Common_questions/What_is_a_domain_name","_id":"6a686a7033d15c8310860af7"},{"type":"article","title":"What is a Domain Name? | Domain name vs. URL","url":"https://www.cloudflare.com/en-gb/learning/dns/glossary/what-is-a-domain-name/","_id":"6a686a7033d15c8310860af8"},{"type":"video","title":"What is a Domain Name?","url":"https://www.youtube.com/watch?v=lMHzpBwPuG8","_id":"6a686a7033d15c8310860af9"}],"updatedAt":"2026-07-28T08:38:08.226Z","lessonPacks":[{"_id":"6a022a7470a823016f6a40d0","title":"Internet Fundamentals","slug":"internet","description":"How the internet actually works: DNS, HTTP, hosting, and browsers.","lessonIds":["69fccda60b8e639b4ca07524","69fd23ffae6bff225ab2f41a","69fd40dcbb4e54de8ab4f8c1","69fdc24a70a823016f69fe98","69fe064070a823016f6a009b","6a01c68c70a823016f6a062e"],"projectIds":[],"featuredImage":"","readingTime":46,"lessonCount":6,"quizCount":0,"projectCount":0}],"paidResources":[{"_id":"6a5e04dbfb5fcb94d041615c","title":"Scrimba - Frontend Developer Career Path","partner":"Scrimba","type":"course","url":"https://v2.scrimba.com/the-frontend-developer-career-path-c0j?via=roadmap"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/frontend/content/ZhSuu2VArnzPDp6dPQQSC.md"}
