{"_id":"6a2fef7b2204ffbc59e5a358","roadmapSlug":"python-data-analysis","nodeId":"j1jq5_64lBuYQQjJWKIuI","description":"# conda\n\nconda is an open-source package and environment manager included with the Anaconda and Miniconda distributions. It manages both Python packages and non-Python dependencies, making it well suited for scientific computing. conda environments isolate project dependencies and can be exported to `environment.yml` for reproducibility.","resources":[{"type":"official","title":"Anaconda","url":"https://www.anaconda.com/","_id":"6a75d326b0650226a50aeb5b"},{"type":"video","title":"Anaconda (Conda) for Python - What & Why?","url":"https://www.youtube.com/watch?v=23aQdrS58e0","_id":"6a75d326b0650226a50aeb5c"},{"type":"video","title":"Master the basics of Conda environments in Python","url":"https://www.youtube.com/watch?v=1VVCd0eSkYc","_id":"6a75d326b0650226a50aeb5d"}],"createdAt":"2026-06-15T12:26:35.269Z","updatedAt":"2026-08-07T12:44:22.099Z","lessonPacks":[],"paidResources":[{"_id":"6a5e3360acf8c05faf5e1c2a","title":"DataCamp - Data Analyst with Python","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/QY0dY9"},{"_id":"6a5e3365acf8c05faf5e1ded","title":"DataCamp - Python Data Fundamentals","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/k4V24x"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/python-data-analysis/content/j1jq5_64lBuYQQjJWKIuI.md"}