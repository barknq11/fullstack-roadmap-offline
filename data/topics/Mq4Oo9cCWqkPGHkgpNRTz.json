{"_id":"68dcfc87166b018f83df7c1b","roadmapSlug":"css","nodeId":"Mq4Oo9cCWqkPGHkgpNRTz","description":"# Text Shadows\n\nText shadows in CSS add depth and visual interest to text by creating a blurred, offset copy of the text behind it. This effect is achieved using the `text-shadow` property, which allows you to specify the shadow's horizontal offset, vertical offset, blur radius, and color. Multiple shadows can be applied to a single text element, creating complex and layered effects.","resources":[{"type":"article","title":"text-shadow","url":"https://developer.mozilla.org/en-US/docs/Web/CSS/text-shadow","_id":"6a67293033d15c831021450d"},{"type":"video","title":"Learn CSS shadows in 3 minutes!","url":"https://www.youtube.com/watch?v=Yqs_61ub1Ng","_id":"6a67293033d15c831021450e"}],"createdAt":"2025-10-01T10:03:51.231Z","updatedAt":"2026-07-27T09:47:28.129Z","lessonPacks":[{"_id":"6a22adddac1c5fa9928ab3ab","title":"CSS Fundamentals","slug":"css","description":"Style, lay out, and debug real pages without fighting the cascade.","lessonIds":["6a15d62fac1c5fa9928a3fb6","6a15e1b0ac1c5fa9928a403f","6a16f11aac1c5fa9928a7c14","6a19dcdfac1c5fa9928a84a5","6a19e79cac1c5fa9928a8571","6a19f85cac1c5fa9928a8654","6a1d7a23ac1c5fa9928a8b4e","6a1dd2daac1c5fa9928a9884","6a1ecf18ac1c5fa9928a9a81","6a1f3245ac1c5fa9928a9cdd","6a20aa64ac1c5fa9928aa44a","6a20ba69ac1c5fa9928aa755","6a20c105ac1c5fa9928aa818","6a20c2e5ac1c5fa9928aa847","6a20c490ac1c5fa9928aa871","6a20c5adac1c5fa9928aa884","6a20c6a5ac1c5fa9928aa897","6a20c7c5ac1c5fa9928aa8aa","6a20ca2fac1c5fa9928aa8d0","6a20cb82ac1c5fa9928aa8e3"],"projectIds":["68b7185fffbff9183d772aed","68b7185fffbff9183d772aee","68b7185fffbff9183d772af0","68b7185fffbff9183d772af6","6a26960eac1c5fa9928acb63","6a26b431ac1c5fa9928acefa"],"featuredImage":"","readingTime":174,"lessonCount":20,"quizCount":0,"projectCount":6}],"paidResources":[],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/css/content/Mq4Oo9cCWqkPGHkgpNRT