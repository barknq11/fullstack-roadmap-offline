{"_id":"68d3f4f5166b018f83df61f1","roadmapSlug":"html","nodeId":"R0mDuO5V5NJI8Yupc_i8i","description":"# Class Attribute\n\nThe `class` attribute in HTML is used to specify one or more class names for an HTML element. These class names can then be used by CSS and JavaScript to style and manipulate specific elements or groups of elements that share the same class. Essentially, it's a way to categorize and target elements for styling and scripting purposes.","resources":[{"type":"article","title":"HTML class global attribute","url":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Global_attributes/class","_id":"6a71e295b0650226a59f1b8a"},{"type":"article","title":"HTML Class","url":"https://www.codecademy.com/resources/docs/html/attributes/class","_id":"6a71e295b0650226a59f1b8b"},{"type":"video","title":"HTML - Classes | W3Schools","url":"https://www.youtube.com/watch?v=tWIkDOJo0Ts","_id":"6a71e295b0650226a59f1b8c"}],"createdAt":"2025-09-24T13:41:09.522Z","updatedAt":"2026-08-04T13:01:09.024Z","lessonPacks":[{"_id":"6a10b41ba95e0d5c68dede2f","title":"HTML Fundamentals","slug":"html","description":"Enough HTML to read, write, inspect, and understand real web pages.","lessonIds":["6a0da437a95e0d5c68ded033","6a0ef00da95e0d5c68ded162","6a0f1366a95e0d5c68ded2b4","6a0f2262a95e0d5c68ded32a","6a0f33e7a95e0d5c68ded463","6a102d2fa95e0d5c68ded758","6a106a2ba95e0d5c68deda00","6a107b29a95e0d5c68deda53"],"projectIds":["68b7185fffbff9183d772aea","68b7185fffbff9183d772aeb","6a1485bfac1c5fa9928a2087","6a1485c5ac1c5fa9928a2093","6a1485cbac1c5fa9928a2099","6a1485d1ac1c5fa9928a20a4"],"featuredImage":"","readingTime":58,"lessonCount":8,"quizCount":0,"projectCount":6}],"paidResources":[],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/html/content/R0mDuO5V5NJI8Yupc_i8i.md"}