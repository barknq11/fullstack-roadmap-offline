{"_id":"68a7362e8ec3d8323af1c366","nodeId":"_94NrQ3quc4t_PPOsFSN0","roadmapSlug":"python","createdAt":"2025-08-21T15:07:26.571Z","description":"# Common Packages and Modules\n\nPython has a rich ecosystem of packages and modules that can be used to get the most out of the language. A package is essentially a directory that contains multiple modules and subpackages. A module is a single file that contains a collection of related functions, classes, and variables. Modules are the basic building blocks of Python code organization. A module can be thought of as a container that holds a set of related code.","resources":[{"type":"official","title":"requests","url":"https://docs.python-requests.org/en/latest/","_id":"6a75d319b0650226a50ae3d2"},{"type":"official","title":"pathlib","url":"https://docs.python.org/3/library/pathlib.html","_id":"6a75d319b0650226a50ae3d3"},{"type":"official","title":"asyncio","url":"https://docs.python.org/3/library/asyncio.html","_id":"6a75d319b0650226a50ae3d4"},{"type":"official","title":"dataclasses","url":"https://docs.python.org/3/library/dataclasses.html","_id":"6a75d319b0650226a50ae3d5"},{"type":"official","title":"python-dotenv","url":"https://pypi.org/project/python-dotenv/","_id":"6a75d319b0650226a50ae3d6"},{"type":"official","title":"numpy","url":"https://numpy.org/doc/stable/","_id":"6a75d319b0650226a50ae3d7"},{"type":"official","title":"pandas","url":"https://pandas.pydata.org/docs/","_id":"6a75d319b0650226a50ae3d8"}],"updatedAt":"2026-08-07T12:44:09.455Z","lessonPacks":[],"paidResources":[{"_id":"6a5e33faacf8c05faf5e1fd0","title":"DataCamp - Python Programming Fundamentals","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/L0YnzL"},{"_id":"6a5e33fdacf8c05faf5e2124","title":"DataCamp - Python Developer","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/vDW623"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/python/content/_94NrQ3quc4t_PPOsFSN0.md"}