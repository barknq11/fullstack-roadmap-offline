{"_id":"6a2fef712204ffbc59e5a34a","roadmapSlug":"python-data-analysis","nodeId":"6dJaQRj2zMz00sfTiTdww","description":"# pip\n\npip is Python's default package installer. It installs packages from the Python Package Index (PyPI) using `pip install package-name`. Libraries like NumPy, Pandas, Matplotlib, and Scikit-learn are all installed this way. A `requirements.txt` file captures all dependencies for a project.","resources":[{"type":"official","title":"Installing Packages","url":"https://packaging.python.org/en/latest/tutorials/installing-packages/","_id":"6a75d326b0650226a50aebcc"},{"type":"opensource","title":"pip","url":"https://github.com/pypa/pip","_id":"6a75d326b0650226a50aebcd"},{"type":"video","title":"Python pip ≡ƒÅù∩╕Å","url":"https://www.youtube.com/watch?v=9z7gGUbAj5U","_id":"6a75d326b0650226a50aebce"}],"createdAt":"2026-06-15T12:26:25.450Z","updatedAt":"2026-08-07T12:44:22.099Z","lessonPacks":[],"paidResources":[{"_id":"6a5e3360acf8c05faf5e1c2a","title":"DataCamp - Data Analyst with Python","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/QY0dY9"},{"_id":"6a5e3365acf8c05faf5e1ded","title":"DataCamp - Python Data Fundamentals","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/k4V24x"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/python-data-analysis/content/6dJaQRj2zMz00sfTiTdww.md"}