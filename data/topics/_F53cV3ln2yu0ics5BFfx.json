{"_id":"68a736128ec3d8323af14ccc","nodeId":"_F53cV3ln2yu0ics5BFfx","roadmapSlug":"data-engineer","createdAt":"2025-08-21T15:06:58.672Z","description":"# Elasticsearch\n\nElasticsearch is a distributed search and analytics engine built on Apache Lucene. It is designed for full-text search, log analysis, and real-time data exploration. Elasticsearch is commonly used as the backend for search features in applications and as a centralized store for log and event data, often alongside Kibana.","resources":[{"type":"roadmap","title":"Visit the Dedicated Elasticsearch Roadmap","url":"https://roadmap.sh/elasticsearch","_id":"6a7f4a42cb44947debcf5359"},{"type":"official","title":"Elasticsearch Website","url":"https://www.elastic.co/elasticsearch/","_id":"6a7f4a42cb44947debcf535a"},{"type":"official","title":"Elasticsearch Documentation","url":"https://www.elastic.co/guide/index.html","_id":"6a7f4a42cb44947debcf535b"},{"type":"video","title":"What is Elasticsearch","url":"https://www.youtube.com/watch?v=ZP0NmfyfsoM","_id":"6a7f4a42cb44947debcf535c"}],"updatedAt":"2026-08-14T17:02:58.294Z","lessonPacks":[],"paidResources":[{"_id":"6a5e04e1fb5fcb94d0417044","title":"DataCamp - Associate Data Engineer in SQL","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/WOP6XG"},{"_id":"6a5e04e1fb5fcb94d0417100","title":"DataCamp - Data Engineer in Python","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/JkYLbr"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/data-engineer/content/_F53cV3ln2yu0ics5BFfx.md"}