{"_id":"68a736178ec3d8323af1640b","nodeId":"-8wAzF6_3gruiM3VYMvB0","roadmapSlug":"docker","createdAt":"2025-08-21T15:07:03.460Z","description":"# Reducing Image Size\n\nReducing Docker image size is crucial for optimizing storage, transfer speeds, and deployment times. Key strategies include using minimal base images like Alpine Linux, leveraging multi-stage builds to exclude unnecessary build tools, removing unnecessary files and packages, and minimizing the number of layers by combining commands.","resources":[{"type":"official","title":"Multi-stage builds","url":"https://docs.docker.com/build/building/multi-stage/","_id":"69ca2cc033a0ad7a578dbab3"},{"type":"official","title":"Docker Best Practices","url":"https://docs.docker.com/develop/develop-images/dockerfile_best-practices/","_id":"69ca2cc033a0ad7a578dbab4"},{"type":"feed","title":"Explore top posts about Security","url":"https://app.daily.dev/tags/security?ref=roadmapsh","_id":"69ca2cc033a0ad7a578dbab5"}],"updatedAt":"2026-03-30T07:56:48.897Z","lessonPacks":[],"paidResources":[{"_id":"6a5e04e0fb5fcb94d0416d80","title":"DataCamp - Introduction to Docker","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/zzDy1W"},{"_id":"6a5e04e0fb5fcb94d0416df4","title":"DataCamp - Containerization and Virtualization","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/GbEdZ2"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/docker/content/-8wAzF6_3gruiM3VYMvB0.md"}