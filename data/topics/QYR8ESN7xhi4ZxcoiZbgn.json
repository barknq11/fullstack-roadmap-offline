{"_id":"68a736128ec3d8323af14b00","nodeId":"QYR8ESN7xhi4ZxcoiZbgn","roadmapSlug":"data-engineer","createdAt":"2025-08-21T15:06:58.672Z","description":"# Cassandra\n\nApache Cassandra is an open-source distributed wide-column database designed for high availability and linear scalability. It has no single point of failure and is optimized for fast writes across multiple data centers. Cassandra is used for time-series data, IoT workloads, and applications requiring continuous uptime.","resources":[{"type":"official","title":"Apache Cassandra","url":"https://cassandra.apache.org/_/index.html","_id":"6a7f4a42cb44947debcf52b2"},{"type":"article","title":"Cassandra - Quick Guide","url":"https://www.tutorialspoint.com/cassandra/cassandra_quick_guide.htm","_id":"6a7f4a42cb44947debcf52b3"},{"type":"video","title":"Apache Cassandra - Course for Beginners","url":"https://www.youtube.com/watch?v=J-cSy5MeMOA","_id":"6a7f4a42cb44947debcf52b4"}],"updatedAt":"2026-08-14T17:02:58.294Z","lessonPacks":[],"paidResources":[{"_id":"6a5e04e1fb5fcb94d0417044","title":"DataCamp - Associate Data Engineer in SQL","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/WOP6XG"},{"_id":"6a5e04e1fb5fcb94d0417100","title":"DataCamp - Data Engineer in Python","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/JkYLbr"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/data-engineer/content/QYR8ESN7xhi4ZxcoiZbgn.md"}