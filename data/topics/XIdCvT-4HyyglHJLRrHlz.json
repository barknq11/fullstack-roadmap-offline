{"_id":"68a736268ec3d8323af1a5f4","nodeId":"XIdCvT-4HyyglHJLRrHlz","roadmapSlug":"mlops","createdAt":"2025-08-21T15:07:18.833Z","description":"# Docker\n\nDocker is a platform that uses operating system-level virtualization to deliver software in packages called containers. These containers isolate software from its environment and ensure that it works uniformly despite differences between development and production environments. Docker simplifies the process of building, shipping, and running applications by packaging all dependencies, libraries, and configurations into a single unit.","resources":[{"type":"roadmap","title":"Visit Dedicated Docker Roadmap","url":"https://roadmap.sh/docker","_id":"6a7f4ad3cb44947debcfa646"},{"type":"official","title":"Docker Documentation","url":"https://docs.docker.com/","_id":"6a7f4ad3cb44947debcfa647"},{"type":"article","title":"A Data ScientistΓÇÖs Guide to Docker Containers","url":"https://towardsdatascience.com/a-data-scientists-guide-to-docker-containers/?utm_source=roadmap&utm_medium=Referral&utm_campaign=TDS+roadmap+integration","_id":"6a7f4ad3cb44947debcfa648"},{"type":"video","title":"Docker Tutorial","url":"https://www.youtube.com/watch?v=RqTEHSBrYFw","_id":"6a7f4ad3cb44947debcfa649"},{"type":"video","title":"Docker Simplified in 55 Seconds","url":"https://youtu.be/vP_4DlOH1G4","_id":"6a7f4ad3cb44947debcfa64a"},{"type":"feed","title":"Explore top posts about Docker","url":"https://app.daily.dev/tags/docker?ref=roadmapsh","_id":"6a7f4ad3cb44947debcfa64b"}],"updatedAt":"2026-08-14T17:05:22.994Z","lessonPacks":[],"paidResources":[{"_id":"6a5e04dcfb5fcb94d04168aa","title":"DataCamp - MLOps Fundamentals","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/L0Ynzo"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/mlops/content/XIdCvT-4HyyglHJLRrHlz.md"}