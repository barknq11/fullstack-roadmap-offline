{"_id":"68a736078ec3d8323af10bc1","nodeId":"CGVstUxVXLJcYZrwk3iNQ","roadmapSlug":"ai-agents","createdAt":"2025-08-21T15:06:47.637Z","description":"# MCP Client\n\nThe MCP Client is the part of an AI agent that talks to the language model API. It collects messages, files, and tool signals, packs them using the Model Context Protocol, and sends them to the model. When a reply comes back, it unpacks it, checks the format, and passes the result to other modules. It also tracks token usage, filters private data, retries failed calls, and logs important events for debugging.","resources":[{"type":"official","title":"Model Context Protocol","url":"https://modelcontextprotocol.io/introduction","_id":"6a7f49c5cb44947debcf0711"},{"type":"official","title":"OpenAI API Reference","url":"https://platform.openai.com/docs/api-reference","_id":"6a7f49c5cb44947debcf0712"},{"type":"official","title":"Anthropic API Documentation","url":"https://docs.anthropic.com/claude/reference","_id":"6a7f49c5cb44947debcf0713"},{"type":"opensource","title":"Model Context Protocol","url":"https://github.com/modelcontextprotocol/modelcontextprotocol","_id":"6a7f49c5cb44947debcf0714"}],"updatedAt":"2026-08-14T17:00:53.866Z","lessonPacks":[],"paidResources":[{"_id":"6a5e04e1fb5fcb94d0416fd1","title":"DataCamp - AI Agents Fundamentals","partner":"DataCamp","type":"course","url":"https://datacamp.pxf.io/QYxNPM"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/ai-agents/content/CGVstUxVXLJcYZrwk3iNQ.md"}