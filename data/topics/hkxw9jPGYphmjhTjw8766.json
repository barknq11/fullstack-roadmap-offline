{"_id":"68a7360d8ec3d8323af1244b","nodeId":"hkxw9jPGYphmjhTjw8766","roadmapSlug":"backend","createdAt":"2025-08-21T15:06:53.149Z","description":"# DNS\n\nDNS (Domain Name System) translates human-readable domain names into IP addresses. Uses hierarchical structure with root servers, TLD servers (.com, .org), authoritative servers, and local DNS servers. Essential for internet functionality, enabling memorable names instead of IP addresses.","resources":[{"type":"article","title":"Everything You Need to Know About DNS","url":"https://cs.fyi/guide/everything-you-need-to-know-about-dns","_id":"6a7588bab0650226a5eb44a4"},{"type":"article","title":"What is DNS?","url":"https://www.cloudflare.com/en-gb/learning/dns/what-is-dns/","_id":"6a7588bab0650226a5eb44a5"},{"type":"article","title":"How DNS works (comic)","url":"https://howdns.works/","_id":"6a7588bab0650226a5eb44a6"},{"type":"video","title":"DNS and How does it Work?","url":"https://www.youtube.com/watch?v=Wj0od2ag5sk","_id":"6a7588bab0650226a5eb44a7"}],"updatedAt":"2026-08-07T07:26:50.654Z","lessonPacks":[{"_id":"6a022a7470a823016f6a40d0","title":"Internet Fundamentals","slug":"internet","description":"How the internet actually works: DNS, HTTP, hosting, and browsers.","lessonIds":["69fccda60b8e639b4ca07524","69fd23ffae6bff225ab2f41a","69fd40dcbb4e54de8ab4f8c1","69fdc24a70a823016f69fe98","69fe064070a823016f6a009b","6a01c68c70a823016f6a062e"],"projectIds":[],"featuredImage":"","readingTime":46,"lessonCount":6,"quizCount":0,"projectCount":0}],"paidResources":[{"_id":"6a5e04ddfb5fcb94d0416a06","title":"Scrimba - Backend Developer Career Path","partner":"Scrimba","type":"course","url":"http://scrimba.com/the-backend-developer-path-c0tbi0l98f?via=roadmap"}],"contribution":"https://github.com/kamranahmedse/developer-roadmap/tree/master/roadmaps/backend/content/hkxw9jPGYphmjhTjw8766.md"}